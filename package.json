{
  "name": "@alissonramosz/handoff-evals",
  "version": "0.1.0",
  "description": "Multilingual test cases and a scorer for AI enquiry routing and human handoff (EN, PT, ES, RU).",
  "keywords": [
    "evals",
    "llm",
    "evaluation",
    "multilingual",
    "customer-support",
    "handoff",
    "dataset",
    "typescript"
  ],
  "license": "MIT",
  "author": "Alisson Ramos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alissonramosz/handoff-evals.git"
  },
  "homepage": "https://github.com/alissonramosz/handoff-evals#readme",
  "bugs": {
    "url": "https://github.com/alissonramosz/handoff-evals/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "handoff-evals": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "dataset",
    "examples",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "baselines": "npm run build && node dist/cli.js baselines",
    "export": "npm run build && node dist/cli.js export > dataset/cases.jsonl",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9",
    "vitest": "^5.1.1"
  }
}
